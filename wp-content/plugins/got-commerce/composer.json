{
  "name": "got/got-commerce",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "GOT\\Commerce\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "php-stubs/woocommerce-stubs": "^10.0"
  },
  "scripts": {
    "test": "php tests/run.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --no-progress",
    "lint": "phpcs --standard=phpcs.xml.dist"
  }
}
